{
  "name": "forebrain-vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.1",
  "publisher": "forebrain",
  "license": "Apache-2.0",
  "engines": { "vscode": "^1.100.0" },
  "l10n": "./l10n",
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "activationEvents": ["onView:forebrain.chat", "onView:forebrain.checklist"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [{ "id": "forebrain", "title": "%container.forebrain%", "icon": "assets/forebrain.svg" }]
    },
    "views": {
      "forebrain": [
        { "id": "forebrain.chat", "name": "%view.chat%", "type": "webview", "contextualTitle": "%container.forebrain%" },
        { "id": "forebrain.checklist", "name": "%view.checklist%", "contextualTitle": "%container.forebrain%" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "forebrain.checklist",
        "contents": "%view.checklistWelcome%",
        "when": "forebrain.checklistEmpty"
      }
    ],
    "commands": [
      { "command": "forebrain.openPanel", "title": "%command.openPanel%" },
      { "command": "forebrain.enterGatewayToken", "title": "%command.enterGatewayToken%" },
      { "command": "forebrain.openWebUiInBrowser", "title": "%command.openWebUiInBrowser%", "icon": "$(link-external)" },
      { "command": "forebrain.reconnect", "title": "%command.reconnect%" },
      { "command": "forebrain.askAboutSelection", "title": "%command.askAboutSelection%", "icon": "$(comment-discussion)" },
      { "command": "forebrain.askAboutFile", "title": "%command.askAboutFile%", "icon": "$(comment-discussion)" },
      { "command": "forebrain.openDeliveredFile", "title": "%command.openDeliveredFile%" },
      { "command": "forebrain.devOpenWebview", "title": "Forebrain: Open Webview (dev)" }
    ],
    "keybindings": [
      { "command": "forebrain.askAboutSelection", "key": "ctrl+alt+k", "mac": "ctrl+cmd+k", "when": "editorHasSelection" }
    ],
    "menus": {
      "editor/context": [
        { "when": "editorHasSelection", "command": "forebrain.askAboutSelection", "group": "9_forebrain" },
        { "when": "!editorHasSelection", "command": "forebrain.askAboutFile", "group": "9_forebrain" }
      ],
      "explorer/context": [
        { "when": "resourceScheme == file && !explorerResourceIsFolder", "command": "forebrain.askAboutFile", "group": "9_forebrain" }
      ],
      "view/title": [
        { "when": "view == forebrain.chat", "command": "forebrain.openWebUiInBrowser", "group": "navigation@1" }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "forebrain.gatewayUrl": {
          "type": "string", "default": "http://127.0.0.1:6060",
          "description": "%config.gatewayUrl%"
        },
        "forebrain.binaryPath": {
          "type": "string", "default": "",
          "description": "%config.binaryPath%"
        },
        "forebrain.autoStartGateway": {
          "type": "boolean", "default": true,
          "description": "%config.autoStartGateway%"
        },
        "forebrain.relayLogRequests": {
          "type": "boolean", "default": false,
          "description": "%config.relayLogRequests%"
        },
        "forebrain.selectionTarget": {
          "type": "string", "enum": ["current", "always-new"], "default": "current",
          "enumDescriptions": ["%config.selectionTarget.current%", "%config.selectionTarget.alwaysNew%"],
          "description": "%config.selectionTarget%"
        },
        "forebrain.includeDiagnostics": {
          "type": "boolean", "default": true,
          "description": "%config.includeDiagnostics%"
        },
        "forebrain.approvalNotifications": {
          "type": "boolean", "default": true,
          "description": "%config.approvalNotifications%"
        }
      }
    }
  },
  "scripts": {
    "compile": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node build.mjs --test",
    "test": "node --test 'dist-test/*.test.js'"
  },
  "dependencies": {
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.100.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}