; Local dev configuration for `npm link` (launcher-flow testing).
; The 5 @forebrain-harness/forebrain-* optionalDependencies are published platform
; packages; locally the launcher (bin/forebrain.js) resolves the binary from
; dist/ or build/bin instead, so resolving them from the registry — and the
; install-time audit POST — only adds multi-minute network timeouts when the
; route to registry.npmjs.org is flaky, with nothing to gain. This file only
; applies to npm commands run inside this directory and is never published.
audit=false
omit=optional
