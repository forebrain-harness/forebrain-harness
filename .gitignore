.tmp/
.worktrees/
openclaw
skills-lock.json
.agents
.claude/*
!.claude/skills/
.forebrain/*
!.forebrain/skills/
.env
build
# The tokenizers static library is fetched, not committed:
# scripts/fetch-libtokenizers.sh places it at third_party/libtokenizers/<goos>_<goarch>/
# (fixed version + sha256). See pkg/llm/hftok.
third_party/libtokenizers/
# The PDFium native library is fetched, not committed:
# scripts/fetch-pdfium.sh places it at third_party/pdfium/<goos>_<goarch>/
# (pinned release + sha256, plus a generated pdfium.pc). See pkg/pdf.
third_party/pdfium/
# The CJK fallback fonts are fetched, not committed:
# scripts/fetch-pdfium-fonts.sh places them at assets/fonts/*.otf
# (pinned npm package + sha256, OFL-1.1). See assets/fonts/README.md.
assets/fonts/*.otf
.idea
.cursor
.DS_Store
node_modules
dist
# pkg/gateway/dist is committed: it is the built web UI that go:embed serves,
# and `go install` builds from the tagged source, which must contain it. Only
# the release workflow rewrites it (scripts/check-webui-dist.sh).
!pkg/gateway/dist/
*.exe
*.test
/forebrain
/forebrain.exe
pkg/run/workspace/
pkg/gateway/workspace/
# Project-level MCP servers are repository content, not local state: the file
# travels with the checkout so everyone working here gets the same servers.
!.forebrain/mcp_servers.yaml
claudecode
coverage.out
.codegraph
.gocache/
.tmpgocache/
# Local reverse-engineering scratch: binary strings dumps, captured command
# output, and throwaway HOME trees. Large and machine-specific.
.boost-analysis/
docs/plan/TOKEN_OPTIMIZATION.md

# Generated by scripts/manifest-report.sh; CI uploads it as an artifact.
manifest-report.md


# The documentation site is its own repository
# (github.com/forebrain-harness/forebrain-harness.github.io); a clone kept here
# must not be added as a submodule-less gitlink.
/forebrain-harness.github.io/

# Migrate fixtures reproduce other agents' homes (.claude, .codex); a
# developer's global ignore (for example **/.claude/settings.local.json) must
# never hide repository content from a commit.
!pkg/migrate/testdata/**
pkg/migrate/testdata/**/.DS_Store
